  "tools": [
    {
      "name": "read_file",
      "description": "Read the full text contents of a file in the workspace. Path is resolved relative to the workspace root and must not escape it.",
      "availability": "base",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "Path to the file, relative to the workspace root.",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      }
    },
    {
      "name": "write_file",
      "description": "Create or overwrite a file in the workspace with the given content, creating parent directories as needed. Requires user permission.",
      "availability": "base",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "description": "The full new contents of the file.",
            "type": "string"
          },
          "path": {
            "description": "Path to the file, relative to the workspace root.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "content"
        ],
        "type": "object"
      }
    },
    {
      "name": "edit_file",
      "description": "Replace a single unique occurrence of old_string with new_string in an existing file. Fails if old_string is not found or is not unique. Requires user permission.",
      "availability": "base",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "new_string": {
            "description": "The text to replace old_string with.",
            "type": "string"
          },
          "old_string": {
            "description": "The exact, unique text to find in the file.",
            "type": "string"
          },
          "path": {
            "description": "Path to the file, relative to the workspace root.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "old_string",
          "new_string"
        ],
        "type": "object"
      }
    },
    {
      "name": "list_dir",
      "description": "List the entries of a directory in the workspace, returning each entry's name, whether it is a directory, and its size in bytes.",
      "availability": "base",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "Path to the directory, relative to the workspace root.",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      }
    },
    {
      "name": "glob",
      "description": "Find files by glob pattern, skipping VCS, dependency, and build directories. Results are workspace-relative, most-recently-modified first, and capped at 300.",
      "availability": "base",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "Optional workspace-relative directory to search. Defaults to the whole workspace.",
            "type": "string"
          },
          "pattern": {
            "description": "Glob pattern such as **/*.rs or src/**/test_*.py.",
            "type": "string"
          }
        },
        "required": [
          "pattern"
        ],
        "type": "object"
      }
    },
    {
      "name": "grep",
      "description": "Search for a regular expression pattern across files in the workspace (skipping .git, node_modules, target, and dist), returning matching file, line number, and line text, capped at 200 matches.",
      "availability": "base",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "Optional directory or file to scope the search to, relative to the workspace root. Defaults to the whole workspace.",
            "type": "string"
          },
          "pattern": {
            "description": "Regular expression pattern to search for.",
            "type": "string"
          }
        },
        "required": [
          "pattern"
        ],
        "type": "object"
      }
    },
    {
      "name": "run_shell",
      "description": "Run a shell command via `sh -c` in the workspace (or a subdirectory of it), with a 120 second timeout. Returns stdout, stderr, and exit code. Requires user permission.",
      "availability": "base",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "description": "The shell command to execute.",
            "type": "string"
          },
          "cwd": {
            "description": "Optional working directory, relative to the workspace root. Defaults to the workspace root.",
            "type": "string"
          }
        },
        "required": [
          "command"
        ],
        "type": "object"
      }
    },
    {
      "name": "remember",
      "description": "Save a short durable fact about this project or the user's preferences so future conversations remember it. Use for stated preferences, project conventions, and hard-won discoveries (build commands, gotchas). Requires user permission.",
      "availability": "base",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "description": "The fact to remember, written as a short standalone statement (max 500 characters).",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      }
    },
    {
      "name": "web_fetch",
      "description": "Fetch a web page (or plain text/Markdown/JSON/XML document) by URL and return its content as Markdown, with the page title and final URL (after redirects). Long content is windowed to max_chars starting at start_index; the result reports total_chars and truncated so you can page through the rest with a later call. Requires user permission.",
      "availability": "base",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "max_chars": {
            "description": "Maximum characters of content to return in this call (default 20000).",
            "type": "integer"
          },
          "start_index": {
            "description": "Character offset into the full content to start the returned window at (default 0). Use with total_chars/truncated from a previous call to page through a long page.",
            "type": "integer"
          },
          "url": {
            "description": "The http(s) URL to fetch.",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      }
    },
    {
      "name": "web_search",
      "description": "Search the web (keyless DuckDuckGo by default) and return up to `count` ranked results, each with a title, url, and snippet. Follow up with web_fetch to read a result in full. Requires user permission.",
      "availability": "base",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "description": "Number of results to return, 1-10 (default 10).",
            "type": "integer"
          },
          "query": {
            "description": "The search query.",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      }
    },
    {
      "name": "present_plan",
      "description": "Present a structured plan to the user for approval. Call this exactly once, after investigating with read-only tools, then stop and wait — do not call it more than once per turn, and do not attempt to make changes until the user approves.",
      "availability": "plan_mode",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "open_questions": {
            "description": "Optional list of questions to ask the user before proceeding, if anything is ambiguous.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "plan": {
            "description": "The full plan, written as Markdown, describing the changes you intend to make and why.",
            "type": "string"
          },
          "title": {
            "description": "A short (few words) title summarizing the plan.",
            "type": "string"
          }
        },
        "required": [
          "title",
          "plan"
        ],
        "type": "object"
      }
    },
    {
      "name": "search_docs",
      "description": "Search the attached knowledge stack(s) ({stack_names}) for passages relevant to a query. Returns the top matching chunks, each with its source file path and a relevance score. Cite source paths when you use a result.",
      "availability": "stack_attached",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "max_results": {
            "description": "Maximum number of results to return (default 6).",
            "type": "integer"
          },
          "query": {
            "description": "The natural-language search query.",
            "type": "string"
          },
          "stack": {
            "description": "Optional stack name to restrict the search to; defaults to searching every attached stack.",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      }
    },
    {
