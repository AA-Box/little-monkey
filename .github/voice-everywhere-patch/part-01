+                [session_id],
+            )
+            .map_err(|error| error.to_string())?;
+        Ok(VoiceRouteEventRecord {
+            event_id,
+            session_id: session_id.to_string(),
+            generation,
+            kind: kind.to_string(),
+            payload: payload.clone(),
+            created_at_ms: now_ms,
+        })
+    }
