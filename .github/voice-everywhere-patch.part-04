+fn device_online(last_seen_at_ms: Option<u64>, surface_seen_at_ms: Option<u64>, now_ms: u64) -> bool {
+    last_seen_at_ms
+        .into_iter()
+        .chain(surface_seen_at_ms)
+        .max()
+        .is_some_and(|seen| now_ms.saturating_sub(seen) <= ENDPOINT_ONLINE_WINDOW_MS)
+}
