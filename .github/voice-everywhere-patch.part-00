+/// Splits synthesized output into bounded, independently playable Talk frames.
+///
+/// Encoded audio containers cannot be cut at arbitrary byte offsets: a half-WAV
+/// is not a WAV. Small responses therefore pass through untouched. Oversized WAV
+/// responses are re-containerized into complete RIFF/WAVE files, each below the
+/// protocol ceiling and aligned to the source format's block size. Other
+/// oversized containers fail closed until their encoder can emit bounded media
+/// chunks itself; silently slicing MP3/MP4/WebM would create corrupt playback.
+pub(crate) fn bounded_output_audio_chunks(
+    bytes: Vec<u8>,
+    media_type: &str,
+) -> Result<Vec<Vec<u8>>, String> {
+    if bytes.is_empty() {
+        return Err("Synthesized speech was empty".to_string());
+    }
+    if bytes.len() <= MAX_TALK_AUDIO_BYTES {
+        return Ok(vec![bytes]);
