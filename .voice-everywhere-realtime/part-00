+        return Err("Realtime Talk PCM is empty or exceeds one frame".to_string());
+    }
+    let bytes = STANDARD
+        .decode(pcm_base64)
+        .map_err(|_| "Realtime Talk PCM is not valid base64".to_string())?;
+    if bytes.is_empty() || bytes.len() > MAX_TALK_AUDIO_BYTES || bytes.len() % 2 != 0 {
+        return Err("Realtime Talk PCM must contain aligned signed 16-bit samples".to_string());
+    }
+    Ok(())
