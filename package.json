{
  "name": "little-monkey",
  "private": true,
  "version": 1.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build": "pnpm typecheck && vite build",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "build:budget": "pnpm build && pnpm bundle:check",
    "release:preflight": "pnpm build:budget && pnpm test",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:compare:live": "node scripts/smoke-compare-ollama.mjs",
    "test:git-delivery-action": "node .github/actions/little-monkey-review/review.test.mjs",
    "test:rust": "pnpm stage:cli:placeholder && cargo test --manifest-path src-tauri/Cargo.toml",
    "i18n:lint": "vitest run src/lib/i18n/keyLint.test.ts",
    "stage:runtime": "node scripts/stage-managed-runtime.mjs",
    "stage:cli": "node scripts/stage-cli-sidecar.mjs",
    "stage:cli:placeholder": "node scripts/ensure-cli-sidecar-placeholder.mjs",
    "icon:mac-liquid": "tauri-liquid-icon --icon ./src-tauri/icons/AppIcon.icon --name AppIcon --output ./src-tauri/resources --tauri-dir ./src-tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.23.0",
    "mermaid": "^11.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "sql.js": "^1.14.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.2",
    "tauri-liquid-icon": "^1.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
