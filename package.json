{
  "name": "little-monkey",
  "private": true,
  "version": "1.10.0",
  "packageManager": "pnpm@11.5.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build": "pnpm typecheck && vite build",
    "clean:stale-bundle": "node scripts/clear-stale-app-bundle.mjs",
    "build:app": "node scripts/build-app.mjs",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "build:budget": "pnpm build && pnpm bundle:check",
    "release:preflight": "pnpm build:budget && pnpm test && pnpm test:machO && pnpm test:manifest && pnpm test:runtime-archive && pnpm test:managed-runtime && pnpm test:wake-assets && pnpm test:mlx-package && pnpm test:mlx-service && pnpm test:mlx-lily-managed",
    "preview": "vite preview",
    "tauri": "tauri",
    "stage:all": "pnpm stage:runtime && pnpm stage:runtime:tts && pnpm stage:runtime:sd && pnpm stage:whisper && pnpm stage:sherpa-runtime && pnpm stage:wake-word && pnpm stage:cli",
    "dev:app": "pnpm stage:all && pnpm tauri dev",
    "test": "vitest run",
    "test:autonomous-eval": "vitest run src/lib/autonomousTaskEval.e2e.test.ts src/lib/autonomousTask.productionBoundary.test.ts",
    "test:autonomous-eval:live": "node scripts/autonomous-task-live-eval.mjs",
    "test:swarm-models:live": "node scripts/swarm-model-benchmark.mjs",
    "test:headless-resource:live": "node scripts/headless-agent-benchmark.mjs",
    "test:headless-resource:contract": "node --check scripts/headless-agent-benchmark.mjs && node --test scripts/headless-workload-metrics.contract.test.mjs scripts/headless-fixture-repository.contract.test.mjs",
    "test:headless-resource:os": "node scripts/headless-os-sampling.e2e.mjs",
    "test:selfdev:contract": "node --check scripts/selfdev-transaction.mjs && node --check scripts/selfdev-supervised-daemon.mjs && python3 -m py_compile scripts/selfdev-live-provider-stream-acceptance.py && node --test scripts/selfdev-transaction.contract.test.mjs scripts/selfdev-supervised-daemon.contract.test.mjs",
    "test:paired-headless:contract": "python3 -m py_compile scripts/paired-jcode-littlemonkey-live.py scripts/bench-jcode-parity.py scripts/test-bench-jcode-parity.py && python3 scripts/paired-jcode-littlemonkey.contract.test.py && python3 scripts/test-bench-jcode-parity.py",
    "test:native-auth:contract": "node --check scripts/subscription-native-auth.mjs && node --test scripts/subscription-native-auth.contract.test.mjs",
    "test:semantic-memory-live:contract": "python3 -m py_compile scripts/semantic-memory-live-quality.py && python3 scripts/test-semantic-memory-live-quality.py",
    "test:swarm-models:syntax": "node --check scripts/swarm-model-benchmark.mjs",
    "test:swarm-headless:contract": "node --check scripts/swarm-headless-performance.mjs && node --test scripts/swarm-headless-performance.test.mjs scripts/lib/swarmResidentRss.test.mjs",
    "test:swarm-headless:live": "node scripts/swarm-headless-performance.mjs",
    "test:swarm-peer:live": "node scripts/swarm-two-peer-live-acceptance.mjs",
    "test:swarm-peer:syntax": "node --check scripts/swarm-two-peer-live-acceptance.mjs",
    "test:ruflo-mcp:contract": "node --test scripts/swarm-ruflo-mcp-acceptance.contract.test.mjs",
    "test:ruflo-mcp:live": "node scripts/swarm-ruflo-mcp-acceptance.mjs",
    "test:swarm-peer:contract": "node --test scripts/swarm-two-peer-acceptance.contract.test.mjs",
    "test:swarm-physical:contract": "node --check scripts/swarm-replica-stress-live-acceptance.mjs && node --test scripts/swarm-replica-stress-acceptance.contract.test.mjs",
    "test:swarm-physical:stress": "node scripts/swarm-replica-stress-live-acceptance.mjs",
    "test:swarm-telemetry:contract": "node --check scripts/swarm-cross-host-telemetry-live-acceptance.mjs && node scripts/swarm-cross-host-telemetry-live-acceptance.mjs --self-check && node --test scripts/swarm-cross-host-telemetry.contract.test.mjs",
    "test:swarm-telemetry:live": "node scripts/swarm-cross-host-telemetry-live-acceptance.mjs",
    "test:swarm-continuous:contract": "node --check scripts/swarm-continuous-quality.mjs && node --check scripts/swarm-provider-billing.mjs && node --test scripts/swarm-continuous-quality.contract.test.mjs scripts/swarm-provider-billing.contract.test.mjs",
    "test:swarm-continuous:live": "node scripts/swarm-continuous-quality.mjs",
    "test:swarm-billing:live": "node scripts/swarm-provider-billing.mjs",
    "test:compare:live": "node scripts/smoke-compare-ollama.mjs",
    "test:realtime:loopback": "node scripts/realtime-loopback-acceptance.mjs",
    "test:realtime:live": "node scripts/realtime-live-acceptance.mjs",
    "test:git-delivery-action": "node .github/actions/little-monkey-review/review.test.mjs",
    "test:machO": "node scripts/lib/machO.test.mjs",
    "test:manifest": "node scripts/lib/runtimeManifest.test.mjs",
    "test:runtime-archive": "node --test scripts/lib/managedRuntimeArchive.test.mjs",
    "test:updater-security": "node --test scripts/updater-security.contract.test.mjs",
    "test:updater-acceptance": "node --test scripts/updater-acceptance-preflight.contract.test.mjs",
    "test:managed-runtime": "node --check scripts/stage-managed-runtime.mjs && node --test scripts/lib/managedRuntimeManifest.test.mjs",
    "test:wake-assets": "node --test scripts/lib/wakeWordAssets.test.mjs",
    "test:wake-walkthrough": "node scripts/run-wake-walkthrough.mjs",
    "test:rust": "pnpm stage:cli:placeholder && pnpm stage:sherpa-runtime && cargo test --manifest-path src-tauri/Cargo.toml",
    "contract:check": "cargo test --manifest-path src-tauri/Cargo.toml --test contract_abi",
    "i18n:lint": "vitest run src/lib/i18n/keyLint.test.ts src/lib/i18n/localeSync.test.ts",
    "a11y": "vitest run src/lib/a11yAudit.test.tsx",
    "test:install-smoke": "node --test scripts/lib/installSmoke.test.mjs",
    "test:browser-policy": "node --test scripts/lib/controllerBrowserPolicy.test.mjs",
    "test:cli-sidecar": "node --test scripts/lib/cliSidecarPlaceholder.test.mjs",
    "test:tauri-dev-command": "node --test scripts/lib/tauriDevCommand.test.mjs",
    "install:smoke": "node scripts/install-smoke.mjs",
    "stage:runtime": "node scripts/stage-managed-runtime.mjs",
    "stage:runtime:tts": "node scripts/stage-managed-runtime.mjs llama-tts",
    "stage:runtime:sd": "node scripts/stage-managed-runtime.mjs sd",
    "mlx:package": "node scripts/build-mlx-package.mjs",
    "mflux:package": "node scripts/build-mflux-package.mjs",
    "face-swap:package": "node scripts/build-face-swap-package.mjs",
    "mlx:keygen": "node scripts/build-mlx-package.mjs keygen",
    "test:mlx-package": "node --test scripts/lib/mlxPackage.test.mjs",
    "test:mlx-service": "python3 packaging/mlx/service/test_mlx_server.py && python3 packaging/mlx/service/test_mlx_video_server.py",
    "test:mlx-model-e2e": "python3 packaging/mlx/service/test_mlx_model_e2e.py",
    "test:mlx-lily-managed": "python3 packaging/mlx/service/test_lily_managed.py",
    "test:mflux-service": "python3 packaging/mflux/service/test_mflux_image_server.py",
    "codesign:runtime": "node scripts/codesign-managed-runtime.mjs",
    "codesign:runtime:tts": "node scripts/codesign-managed-runtime.mjs llama-tts",
    "codesign:runtime:sd": "node scripts/codesign-managed-runtime.mjs sd",
    "stage:whisper": "node scripts/stage-whisper-model.mjs",
    "stage:sherpa-runtime": "node scripts/stage-sherpa-runtime.mjs",
    "stage:wake-word": "node scripts/stage-wake-word-model.mjs",
    "stage:cli": "node scripts/stage-cli-sidecar.mjs",
    "stage:cli:placeholder": "node scripts/ensure-cli-sidecar-placeholder.mjs",
    "icon:mac-liquid": "tauri-liquid-icon --icon ./src-tauri/icons/AppIcon.icon --name AppIcon --output ./src-tauri/resources --tauri-dir ./src-tauri",
    "test:swarm-specialists:live": "node scripts/swarm-specialist-live-benchmark.mjs",
    "test:swarm-specialists:oracle": "node scripts/swarm-specialist-live-benchmark.mjs --self-check --domain all && node --test scripts/swarm-specialist-oracle.contract.test.mjs",
    "test:swarm-restart:live": "node scripts/swarm-resident-restart-live-acceptance.mjs",
    "test:swarm-repair:live": "node scripts/swarm-repository-repair-live-acceptance.mjs",
    "test:swarm-repair:oracle": "node scripts/swarm-repository-repair-live-acceptance.mjs --self-check && node --test scripts/swarm-repository-repair-acceptance.contract.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.23.0",
    "mermaid": "^11.16.1",
    "quickjs-emscripten": "0.32.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "sql.js": "^1.14.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.2",
    "tauri-liquid-icon": "^1.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
